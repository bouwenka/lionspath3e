[Unit]
Description=Import recent LionsPath Apache logs into private analytics
After=apache2.service

[Service]
Type=oneshot
User=lionspath-analytics
Group=lionspath-analytics
SupplementaryGroups=adm
WorkingDirectory=/opt/lionspath-analytics/current
EnvironmentFile=/etc/lionspath/analytics.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lionspath-analytics/venv/bin/python -m analytics.refresh --rollup-days 3
TimeoutStartSec=5min
StateDirectory=lionspath
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/var/log/apache2
ReadWritePaths=/var/lib/lionspath
LimitNOFILE=1024
TasksMax=32
