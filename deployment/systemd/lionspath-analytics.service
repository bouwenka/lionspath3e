[Unit]
Description=LionsPath private analytics WSGI service
Requires=lionspath-analytics.socket
After=lionspath-analytics.socket

[Service]
Type=simple
User=lionspath-analytics
Group=lionspath-analytics
WorkingDirectory=/opt/lionspath-analytics/current
EnvironmentFile=/etc/lionspath/analytics.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Sockets=lionspath-analytics.socket
ExecStart=/opt/lionspath-analytics/venv/bin/gunicorn --no-control-socket --worker-class gthread --workers 2 --threads 4 --timeout 30 --graceful-timeout 30 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 --error-logfile - --capture-output analytics.app:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=35s
StateDirectory=lionspath
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/lionspath
LimitNOFILE=1024
TasksMax=64

[Install]
WantedBy=multi-user.target
