LIONPATH_ANALYTICS_DB=/var/lib/lionspath/analytics.db
LIONPATH_ANALYTICS_LOG_PATTERN=/var/log/apache2/lionspath_ssl_access.log*
LIONPATH_ANALYTICS_SECRET_FILE=/etc/lionspath/analytics.secret
LIONPATH_ANALYTICS_TIMEZONE=America/New_York
LIONPATH_ANALYTICS_ALLOWED_ORIGINS=https://lionspath.lcps.k12.va.us
LIONPATH_ANALYTICS_ADMIN_HEADER=X-LionsPath-Admin
LIONPATH_ANALYTICS_ADMIN_HEADER_VALUE=1
LIONPATH_ANALYTICS_PROXY_HEADER=X-LionsPath-Proxy
LIONPATH_ANALYTICS_PROXY_HEADER_VALUE=1
