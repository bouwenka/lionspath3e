/var/log/apache2/lionspath_*log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
    sharedscripts
    postrotate
        if [ -f /var/run/apache2/apache2.pid ]; then
            /usr/sbin/apachectl graceful > /dev/null 2>&1 || true
        fi
    endscript
}
